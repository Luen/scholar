# Runtime data (compose volumes)
scholar_data/
cache/
downloaded_files/

# VCS / IDE / editor
.git/
.gitignore
.gitattributes
.github/
.vscode/
.cursor/
.idea/

# Python caches / venvs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
venv/
.venv/

# Logs / temp
*.log
src/logs/

# Env & secrets (mounted at runtime)
.env
.env.*
.env.template
google-credentials.json
*.pem
*.key

# Docs / tests / non-runtime
docs/
*.md
tests/
cron.sh

# Docker meta (not needed inside image)
Dockerfile*
docker-compose*.yml
.dockerignore
base/
web/
cron/
