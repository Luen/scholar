EMAIL_USER=your_email_here
EMAIL_PASS=your_email_password_here

# News Scrapers
SCRAPER_API_KEY=
NEWS_API_ORG_KEY=
NEWSAPI_AI_KEY=
NEWSAPI_COM_KEY=
THE_GUARDIAN_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# News scraper toggles (optional)
# Disable noisy/blocked sources by default for local runs.
NEWS_ENABLE_GOOGLE_SEARCH=0
NEWS_ENABLE_NEWSPAPER4K=0
NEWS_ENABLE_WEB_SCRAPE=0

# Optional: Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0
SCHOLAR_DATA_DIR=scholar_data

# Public API origin (no trailing slash). Set so news thumbnail ``image.url`` in JSON is absolute.
# Production: https://api.rummerlab.com
PUBLIC_API_BASE_URL=https://api.rummerlab.com

# News thumbnails (optional): after filtering, fetch og:image for items with no image
# and store under SCHOLAR_DATA_DIR/news_thumbnails/<id>/ — served at
# GET /scholar/<id>/news/thumbnail/<sha256>.<ext>
NEWS_THUMB_MAX_BYTES=2500000
NEWS_THUMB_FETCH_DELAY_SECONDS=0.25

# Scholar scraper options
CACHE_DIR=cache
CACHE_EXPIRE_SECONDS=2592000
FRESH_DATA_SECONDS=82800
MAX_RETRIES=3
RETRY_BASE_DELAY=5
COAUTHOR_DELAY=2
PUBLICATION_DELAY=1

# PROXY CONFIGURATION (optional)
# SOCKS5 proxies for Altmetric and Google Scholar requests.
# Format per proxy: host:port|username|password (password may contain |).
# Multiple proxies: one per line, or semicolon-separated on one line (round-robin).
# Example (multiline):
# SOCKS5_PROXIES="proxy1.example.com:1080|user1|pass1
# proxy2.example.com:1080|user2|pass2"
# Example (one line with semicolons):
# SOCKS5_PROXIES="host1:1080|u1|p1;host2:1080|u2|p2"

# TOR PROXY CONFIGURATION (optional, tried first)
# Route requests through a Tor container (e.g. zhaowde/rotating-tor-http-proxy).
# Tor is tried first (up to 3 attempts; the proxy handles IP rotation). After
# 3 blocks/failures, requests fall back to SOCKS5_PROXIES.
# TOR_PROXY=http://localhost:3128
TOR_PROXY=

